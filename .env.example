# Safe example values for local development only.
# Copy to .env or export these before starting the app in production.
# Never commit real credentials or private database paths.

# Bind address and port for the ASGI process (uvicorn).
# The app binds 0.0.0.0 so the platform can reach it.
HOST=0.0.0.0
PORT=8000

# Persistent SQLite database path (file). For production deployments point
# this at storage OUTSIDE the release checkout (e.g. a mounted volume),
# otherwise data is lost on redeploy:  /var/lib/taskboard/taskboard.db
DATABASE_PATH=./data/taskboard.db

# Random secret used to sign the session cookie (which backs CSRF tokens).
# Generate once with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Keep it stable across restarts/servers so sessions survive.
SECRET_KEY=change-me-generate-a-random-value

# Optional non-sensitive build/release marker shown in the UI footer to
# distinguish deployed revisions. Defaults to the VERSION file at repo root.
BUILD_MARKER=dev

# Uvicorn logging level: debug | info | warning | error | critical
LOG_LEVEL=info